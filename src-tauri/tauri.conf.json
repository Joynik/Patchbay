{
    "productName": "Patchbay",
    "version": "0.1.0",
    "identifier": "app.patchbay.desktop",
    "build": {
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Patchbay",
                "width": 1180,
                "height": 760,
                "minWidth": 760,
                "minHeight": 540
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app"],
        "icon": ["icons/icon.icns", "icons/icon.png"],
        "resources": ["resources/library.json"]
    }
}
