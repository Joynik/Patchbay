{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "types": ["vite/client"],
        "skipLibCheck": true,
    },
    "include": ["src", "tests/ui", "playwright.config.ts", "vite.config.ts"],
}
