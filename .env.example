# Copy this example to .env and edit the settings you need.
# Remove optional overrides to use the defaults in mise.toml.
# Keep real secrets in .env.

# JavaScript and TypeScript
PROJECT_JAVASCRIPT_DIRECTORY="."
JAVASCRIPT_BUILD_SCRIPT="build"

# Rust
PROJECT_RUST_DIRECTORY="src-tauri"

# Database backup and restore
DATABASE_EXECUTION_MODE="native"
DATABASE_BACKUP_FILE="backup.sql"
DATABASE_RESTORE_FILE=""

# SQLite paths
SQLITE_MODE="local" # local, remote
SQLITE_REMOTE_URL=""
SQLITE_REMOTE_AUTH_TOKEN=""
SQLITE_DATABASE_PATH="data/application.sqlite3"
SQLITE_INIT_SQL=""
